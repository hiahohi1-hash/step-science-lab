# ────────────────────────────────────────────────
# 이 파일은 "예시"입니다.
# 같은 폴더에 .env 라는 파일을 만들고 아래 내용을 복사한 뒤 값을 바꿔 쓰세요.
# .env 파일은 비밀 정보가 들어 있으니 다른 사람에게 보내거나 인터넷에 올리지 마세요.
# ────────────────────────────────────────────────

# 서버 주소 번호(포트)
# HTTP_PORT : 컴퓨터에서 http://localhost:3000 으로 들어갈 때
# HTTPS_PORT: 태블릿·휴대폰에서 https://(컴퓨터 IP):3443 으로 들어갈 때 (카메라는 https에서만 켜짐)
HTTP_PORT=3000
HTTPS_PORT=3443

# 관리자 처음 비밀번호
# - 처음 로그인할 때만 쓰고, 로그인하면 바로 새 비밀번호로 바꾸는 화면이 나옵니다.
# - 바꾼 비밀번호는 암호화되어 데이터베이스에 저장되므로, 그 뒤에는 이 값을 바꿔도 소용없습니다.
#   (비밀번호를 잊었을 때는 README 의 "자주 생기는 문제"를 보세요)
ADMIN_PASSWORD=change-me-1234

